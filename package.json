{
  "name": "self-test",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun src/cli/dev.ts",
    "dev:frontend": "vite",
    "dev:backend": "bun --watch src/backend/server.ts",
    "build": "vite build",
    "deploy": "bun src/cli/deploy.ts",
    "start": "bun src/backend/server.ts",
    "test": "NODE_ENV=test bun test",
    "test:mobile": "bun run scripts/verify-mobile-overflow.ts",
    "test:mobile-landing": "bun run scripts/verify-mobile-guest-landing.ts",
    "provider:config": "bun run src/cli/wizard.ts",
    "eval": "bun run src/cli/eval.ts",
    "eval:debug": "bun run src/cli/eval.ts --debug",
    "eval:mock": "bun run src/cli/eval.ts --mock"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "wrangler": "^4.151.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "@typesafe-ai/sdk": "^0.7.0",
    "canvas-confetti": "^1.9.4",
    "hono": "^4.13.13",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.57.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
