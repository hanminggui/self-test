# =========================================================================
# Metacognitive Testing System - Environment Configuration Template
# =========================================================================

# -------------------------------------------------------------------------
# 1. Server & Security Config
# -------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
ADMIN_PASSWORD=admin_secret_key_888
# Secret key used to sign and verify explorer JWT session cookies
JWT_SECRET=metacognitive-testing-auth-secret-key-2026

# -------------------------------------------------------------------------
# 2. Authentication Channels Master & Provider Switches
# -------------------------------------------------------------------------
# Global authentication switch. Set to false to disable all OAuth channels.
AUTH_ENABLED=true

# Channel toggles (true: enabled, false: disabled)
AUTH_GITHUB_ENABLED=true
AUTH_LINUXDO_ENABLED=true
AUTH_GOOGLE_ENABLED=true

# -------------------------------------------------------------------------
# 3. Third-Party OAuth App Credentials
# -------------------------------------------------------------------------

# --- GitHub OAuth ---
# Register at: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/github/callback (or production URL)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

# --- LinuxDo Connect ---
# Register at: https://connect.linux.do/
# Callback URL: http://localhost:3000/api/auth/linuxdo/callback (or production URL)
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
# LINUXDO_REDIRECT_URI=http://localhost:3000/api/auth/linuxdo/callback

# --- Google Identity OAuth 2.0 ---
# Register at: https://console.cloud.google.com/apis/credentials
# Callback URL: http://localhost:3000/api/auth/google/callback (or production URL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
